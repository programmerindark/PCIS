# Copy this file to ".env.local" and fill in your own values.
# .env.local is git-ignored, so your keys never get committed.

# From Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The PCIS engine API. Local dev default shown; set to your deployed
# API URL (Render/Railway) in production.
NEXT_PUBLIC_PCIS_API_URL=http://127.0.0.1:8000
